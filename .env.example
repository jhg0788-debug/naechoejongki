# ── 사이트 ──────────────────────────────────────────
# 배포 도메인 (끝에 / 없이). 관리자 화면의 쇼츠 링크와 OG 이미지에 쓰여요.
NEXT_PUBLIC_SITE_URL=https://your-domain.vercel.app

# ── Supabase (프로젝트: naechoejongki, 서울) ───────────
SUPABASE_URL=https://kltukfalawlrjrfzoyam.supabase.co
# Supabase 대시보드 → Project Settings → API Keys → service_role (secret)
# 서버 전용. 절대 NEXT_PUBLIC_ 로 시작하게 바꾸지 마세요.
SUPABASE_SERVICE_ROLE_KEY=

# ── 토스페이먼츠 결제위젯 ──────────────────────────────
# 개발자센터 → API 키 → '결제위젯 연동 키' (test_gck_ / test_gsk_)
# 일반 결제창 키(test_ck_/test_sk_)가 아니라 결제위젯 키를 넣어야 해요.
NEXT_PUBLIC_TOSS_CLIENT_KEY=
TOSS_SECRET_KEY=

# ── 관리자 대시보드 (/admin) ──────────────────────────
# 선택. 비우면 Supabase app_config.admin_password_sha256 에 저장된 비밀번호를 써요.
ADMIN_KEY=

# ── 사업자 정보 (토스 라이브 심사·전자상거래법 표시) ───────
# 비우면 화면 하단에 '등록 예정'으로 나와요. 라이브 결제 전에 꼭 채우세요.
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_CEO=
NEXT_PUBLIC_BIZ_REG_NO=
NEXT_PUBLIC_BIZ_MAILORDER_NO=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_EMAIL=
NEXT_PUBLIC_BIZ_PHONE=
# 개인정보 보호책임자 (비우면 대표자)
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER=

# ── 보호자 휴대폰 본인인증 (포트원 V2, 선택) ─────────────────
# 세 값이 모두 있으면 만 14세 미만은 보호자 본인인증을 거쳐야 진행돼요.
# 하나라도 비면 체크박스 동의로 동작해요.
# 포트원 관리자 콘솔 → 연동 정보: 상점 아이디(store-…), 본인인증 채널 키(channel-key-…), V2 API Secret
NEXT_PUBLIC_PORTONE_STORE_ID=
NEXT_PUBLIC_PORTONE_IDV_CHANNEL_KEY=
PORTONE_API_SECRET=

# ── 카카오톡 공유 (선택) ──────────────────────────────
# 카카오 디벨로퍼스 → 내 애플리케이션 → JavaScript 키. 비우면 기기 공유창/복사로 동작해요.
# 플랫폼 → Web 사이트 도메인에 NEXT_PUBLIC_SITE_URL 도메인을 등록해야 해요.
NEXT_PUBLIC_KAKAO_JS_KEY=
