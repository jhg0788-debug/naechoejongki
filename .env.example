# Vercel에는 비밀 키가 필요 없어요. 아래는 전부 선택이에요.
# 비밀 키(결제·본인인증)는 Supabase → Edge Functions → nk-api → Secrets 에 넣어요:
#   TOSS_CLIENT_KEY, TOSS_SECRET_KEY                 토스 결제위젯 키 (test_gck_ / test_gsk_)
#   PORTONE_STORE_ID, PORTONE_IDV_CHANNEL_KEY, PORTONE_API_SECRET   보호자 본인인증
#   ADMIN_KEY                                        (선택) 관리자 비밀번호. 비우면 DB에 저장된 비밀번호

# ── 사이트 주소 (비우면 Vercel 기본 도메인) ──────────────
NEXT_PUBLIC_SITE_URL=

# ── 사업자 정보 (토스 라이브 심사·전자상거래법 표시) ───────
# 비우면 화면 하단에 '등록 예정'으로 나와요. 라이브 결제 전에 꼭 채우세요.
NEXT_PUBLIC_BIZ_NAME=
NEXT_PUBLIC_BIZ_CEO=
NEXT_PUBLIC_BIZ_REG_NO=
NEXT_PUBLIC_BIZ_MAILORDER_NO=
NEXT_PUBLIC_BIZ_ADDRESS=
NEXT_PUBLIC_BIZ_EMAIL=
NEXT_PUBLIC_BIZ_PHONE=
NEXT_PUBLIC_BIZ_PRIVACY_OFFICER=

# ── 카카오톡 공유 (선택) ──────────────────────────────
# 비우면 기기 공유창/복사로 동작해요.
NEXT_PUBLIC_KAKAO_JS_KEY=
